# OGP画像生成用 Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 日本語フォントとPillowのインストール
RUN apt-get update && apt-get install -y \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir Pillow

COPY . /app

# 実行時に ogp フォルダへ移動してスクリプトを走らせる
WORKDIR /app/ogp
CMD ["python", "ogp-generator.py"]
