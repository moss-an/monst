# OGP画像生成用 Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 日本語フォントとCairo（cairosvgの依存関係）のインストール
RUN apt-get update && apt-get install -y \
    fonts-noto-cjk \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY ogp/requirements.txt /app/ogp/
RUN pip install --no-cache-dir -r /app/ogp/requirements.txt

COPY . /app

# 実行時に ogp フォルダへ移動してスクリプトを走らせる
WORKDIR /app/ogp
CMD ["python", "ogp-generator.py"]
